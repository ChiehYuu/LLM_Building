# Copy to .env and fill in real values. Never commit .env.

APP_NAME=llm-building
APP_ENV=development

LLM_PROVIDER=onprem
ALLOW_CLOUD_LLM=false

ONPREM_BASE_URL=https://onprem-llm.internal
ONPREM_CHAT_PATH=/v1/chat/completions
ONPREM_MODEL=your-onprem-model-name

ONPREM_COMPANY=
ONPREM_SYSTEM_ID=
ONPREM_SERVICE_ID=
ONPREM_API_KEY=

# Leave empty until the company CA bundle (root+intermediate, PEM) is
# available. Until then the client falls back to verify=False (dev only).
ONPREM_CA_BUNDLE_PATH=

ONPREM_CONNECT_TIMEOUT_S=10
ONPREM_READ_TIMEOUT_S=110

SQLITE_PATH=./data/checkpoints.sqlite
